{
  "name": "@akashiq/core",
  "version": "0.1.0",
  "description": "Decision types and guards for recording why your code exists and linking it to tests.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znagadeon/akashiq.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/znagadeon/akashiq#readme",
  "bugs": {
    "url": "https://github.com/znagadeon/akashiq/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "keywords": [
    "decisions",
    "traceability",
    "testing",
    "ai-agents",
    "typescript"
  ]
}
