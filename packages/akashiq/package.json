{
  "name": "akashiq",
  "version": "0.1.0",
  "description": "Remember why your code exists. Collects decisions and shows the tests that guard them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znagadeon/akashiq.git",
    "directory": "packages/akashiq"
  },
  "homepage": "https://github.com/znagadeon/akashiq#readme",
  "bugs": {
    "url": "https://github.com/znagadeon/akashiq/issues"
  },
  "type": "module",
  "keywords": [
    "decisions",
    "traceability",
    "testing",
    "ai-agents",
    "agent-skills",
    "dashboard",
    "typescript"
  ],
  "bin": {
    "akashiq": "./src/cli.ts"
  },
  "publishConfig": {
    "bin": {
      "akashiq": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/dashboard/ui', 'dist/dashboard/ui', { recursive: true })\"",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@akashiq/core": "workspace:*"
  }
}
